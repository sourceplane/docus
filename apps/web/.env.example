# Copy to .dev.vars for `pnpm preview` (wrangler dev). Every one is optional.

# The site's public origin (canonical links, the sitemap, llms.txt, Open Graph
# URLs). The deploy sets it per environment; set it yourself for a local build.
NUXT_SITE_URL=http://localhost:3000

# Docus's AI assistant needs an AI Gateway key, which this site does not use:
# without one Docus turns the assistant off, and everything else works.
# AI_GATEWAY_API_KEY=
